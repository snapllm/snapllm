{
  "schema_version": 1,
  "server": {
    "host": "0.0.0.0",
    "port": 6930,
    "cors_enabled": true,
    "timeout_seconds": 600,
    "max_concurrent_requests": 8,
    "max_active_inferences": 1
  },
  "workspace": {
    "root": "/workspace",
    "default_models_path": "/models"
  },
  "runtime": {
    "max_models": 10,
    "default_ram_budget_mb": 16384,
    "default_strategy": "balanced",
    "enable_gpu": true
  }
}