FROM node:22-bookworm AS build

WORKDIR /src/desktop-app
COPY desktop-app/package.json desktop-app/package-lock.json ./
RUN npm ci --ignore-scripts
COPY desktop-app/ ./
ARG VITE_API_URL=http://localhost:6930
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/nginx-ui.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/desktop-app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
